# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: Tavily Web Search API Key (falls back to DuckDuckGo if unset)
TAVILY_API_KEY=

# Optional: Weather API Key (Open-Meteo is used by default without an API key)
WEATHER_API_KEY=

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173
